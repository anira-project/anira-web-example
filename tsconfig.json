{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src", "test"],
  // The 2.x demos not ported to anira 3 yet: each leaves this list with its port.
  "exclude": [
    "test/dist",
    "src/utils/setupDemoUI.ts",
    "src/simple-gain-stereo",
    "src/streaming-gain-stereo",
    "src/js-callback",
    "src/onnxweb-backend",
    "src/js-copying",
    "src/pre-post-processors",
    "src/steerable-nafx",
    "src/guitar-lstm",
    "src/scyclone",
    "src/misc"
  ]
}
