{
  "models": [{ "engine": "onnxruntime", "path": "GuitarLSTM-libtorch-dynamic.onnx" }],
  "inputs": [
    {
      "name": "audio_in",
      "dtype": "float32",
      "role": "streamed",
      "axes": [["any", 512], ["channel", 1], ["time", 150]],
      "window": { "min": 661, "max": 661 },
      "overlap": 149
    }
  ],
  "outputs": [
    {
      "name": "audio_out",
      "dtype": "float32",
      "role": "streamed",
      "axes": [["any", 512], ["time", 1]],
      "window": { "min": 512, "max": 512 }
    }
  ]
}
